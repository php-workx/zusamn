{
  "expo": {
    "name": "Zusamn",
    "slug": "zusamn-mobile",
    "scheme": "zusamn",
    "platforms": ["ios", "android"],
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.zusamn.app",
      "associatedDomains": ["applinks:zusamn.com"]
    },
    "android": {
      "package": "com.zusamn.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "zusamn.com",
              "pathPrefix": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    }
  }
}
