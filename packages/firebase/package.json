  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "^18.0.0",
    "firebase-tools": "^14.5.0",
    "react": "^18.0.0",
    "vitest": "^3.0.0"
  }
}
