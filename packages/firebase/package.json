{
  "name": "@zusamn/firebase",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "firebase emulators:exec --only firestore --project zusamn-test \"vitest run --coverage\"",
    "test:watch": "firebase emulators:exec --only firestore --project zusamn-test \"vitest\""
  },
  "dependencies": {
    "@zusamn/domain": "workspace:*",
    "firebase": "^12.8.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "firebase-tools": "^14.5.0",
    "jsdom": "^26.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vitest": "^4.1.0"
  }
}
